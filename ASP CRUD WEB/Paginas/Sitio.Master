<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Sitio.Master.cs" Inherits="ASP_CRUD_WEB.Paginas.Sitio" %>

<%-- PÁGINA MAESTRA: es la "plantilla" que comparten todas las páginas
     (menú superior + Bootstrap). Cada página pone su contenido en ContentPlaceHolder1 --%>
<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ASP CRUD WEB</title>

    <!-- Bootstrap 5 desde internet (CDN): no hay que instalar nada -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="bg-light">

    <!-- Barra de navegación -->
    <nav class="navbar navbar-dark bg-primary mb-4">
        <div class="container-fluid px-4">
            <a class="navbar-brand" href="Listado.aspx">ASP CRUD WEB</a>
            <span class="navbar-text">ASP.NET + MySQL + Bootstrap</span>
        </div>
    </nav>

    <%-- En Web Forms todo va dentro de UN solo formulario con runat="server" --%>
    <form id="form1" runat="server">
        <div class="container-fluid px-4">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>
    </form>

</body>
</html>
