<?xml version="1.0" encoding="utf-8"?>
<!-- PLANTILLA (esta SÍ se sube a GitHub):
     1. Copia este archivo y renómbralo a "ConnectionStrings.config"
     2. Cambia TU_PASSWORD por la contraseña de tu usuario root de MySQL -->
<connectionStrings>
  <add name="conexion"
       connectionString="Server=localhost;Port=3306;Database=crud_web;Uid=root;Pwd=TU_PASSWORD;"
       providerName="MySql.Data.MySqlClient" />
</connectionStrings>
